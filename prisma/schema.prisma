generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Archive {
  id            Int      @id @default(autoincrement())
  title         String
  year          Int
  videoUrl      String?
  bv            String?
  isTranslated  Int      @default(-1)
  fullVersionId Int?
  fullVersion   Archive? @relation("PartToFull", fields: [fullVersionId], references: [id])
  parts         Archive[] @relation("PartToFull")

  eventId       Int?
  event         Event?   @relation(fields: [eventId], references: [id])

  seriesVol     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id        Int       @id @default(autoincrement())
  title     String
  typeId    Int?
  type      SeriesType? @relation(fields: [typeId], references: [id])
  date      DateTime?
  isVirtual Boolean
  seriesId  Int?
  series    Series?   @relation(fields: [seriesId], references: [id])
  archives  Archive[]
}

model SeriesType {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  series   Series[]
  events   Event[]
}

model Series {
  id           Int         @id @default(autoincrement())
  title        String      @unique
  coverURL     String?
  seriesTypeId Int?
  seriesType   SeriesType? @relation(fields: [seriesTypeId], references: [id])
  events       Event[]
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  prefix      String
  name        String
  permissions Int
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}
